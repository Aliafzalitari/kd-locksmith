---
import Nav from './components/Nav.astro';
import Footer from './components/Footer.astro';
import '../styles/style.css';
const base = import.meta.env.BASE_URL;
---
<!DOCTYPE html>
<html lang="en">
    <head>
    <title>Lock Repair Services North West London | Fast Door & Lock Fixes</title>
    <link rel="icon" type="image/svg+xml" href={`${import.meta.env.BASE_URL}/images/logo.svg?v=2`}>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <link rel="stylesheet" href={base + "/styles/style.css"}>
    </head>
    <body>
	<Nav />
    <section class="service-hero">
        <div class="service-hero-content">
            <span class="hero-tag">Professional Lock & Mechanism Servicing</span>
            <h1>Restore Smooth Operation With Expert Lock Repairs</h1>
            <p>From stuck uPVC multi-point gearboxes to misaligned door frames and stiff cylinders, our mobile locksmiths fix issues on the spot without unnecessary full replacements.</p>
            <div class="hero-cta-group">
                <a href="tel:+447312158704" class="btn-call-red">📞 Speak To Engineer Now</a>
                <a href="#quick-quote" class="btn-quote-white">Request Repair Quote</a>
            </div>
            <div class="hero-feature-badges">
                <div class="badge-item"> uPVC Mechanism Specialists</div>
                <div class="badge-item"> Same-Day On-Site Repairs</div> 
                <div class="badge-item"> 12-Month Guarantee on Parts </div> 
                <div class="badge-item"> Transparent Fixed Rates</div>
            </div>
        </div>
    </section>
    <section class="service-detail-section" id="quick-quote">
        <div class="service-detail-container">
            <div class="service-info-col">
                <h2>Why Repair Instead of Replace?</h2>
                <p>Not every jammed lock or stubborn handle requires a brand-new unit. Often, re-aligning shifting door hinges or replacing a worn internal gearbox restores flawless, effortless security at a fraction of the cost.</p>
                
                <div class="info-highlights">
                    <div class="highlight-item">
                        <h4>Genuine Replacement Parts</h4>
                        <p>Our mobile vans carry replacement gearboxes, springs, and center mechanisms for major brands including Yale, ERA, Avocet, and Fullex.</p>
                    </div>
                    <div class="highlight-item">
                        <h4>Cost-Effective Solutions</h4>
                        <p>We prioritize repairs whenever safe and practical, saving you money while extending the lifespan of your existing door hardware.</p>
                    </div>
                </div>

                <a href="tel:+447312158704" class="btn-call-red">Call 731 2158 704 For Advice</a>
            </div>
        </div>
    </section>
    <section class="sub-service-grid">
        <div class="sub_service-container">
            <h2>Common Faults We Fix On-Site</h2>
            <p class="subtitle">Specialist diagnostic and repair services for domestic and commercial doors.</p>
            
            <div class="sub-service-grid">
                <div class="sub-service-card">
                    <div class="service-icon">⚙️</div>
                    <h3>uPVC Mechanism Gearboxes</h3>
                    <p>Replacing failed center gearboxes inside multipoint strips when door handles drop or fail to lift.</p>
                </div>
                <div class="sub-service-card">
                    <div class="service-icon">🚪</div>
                    <h3>Door Frame Alignment</h3>
                    <p>Adjusting sagging hinges and striking plates so doors close flush without excessive force.</p>
                </div>
                <div class="sub-service-card">
                    <div class="service-icon">🔑</div>
                    <h3>Sticky & Stiff Cylinders</h3>
                    <p>Flushing, servicing, and lubricating pin-tumbler mechanisms that catch or refuse to turn smoothly.</p>
                </div>
                <div class="sub-service-card">
                    <div class="service-icon">🛠️</div>
                    <h3>Broken Key Extraction</h3>
                    <p>Carefully removing snapped metal fragments from lock cylinders without damaging the internal pins.</p>
                </div>
            </div>
        </div>
    </section>
    <section class="Prices-section">
        <div class="price-container">
            <h2>Fixed Repair Rates</h2>
            <p class="subtitle">Clear pricing upfront. No hidden surcharges.</p>
            <div class="price-grid">
                <div class="price-card">
                    <h3>Key Extraction</h3>
                    <p class="price-value">From £49</p>
                    <ul class="price-features">
                        <li>Clean broken fragment removal</li>
                        <li>Cylinder health check included</li>
                        <li>Fast on-site turnaround</li>
                    </ul>
                </div>
                <div class="price-card">
                    <span class="pop-tag">Most Common</span>
                    <h3>Door Alignment & Service</h3>
                    <p class="price-value">From £59</p>
                    <ul class="price-features">
                        <li>Hinge adjustment & calibration</li>
                        <li>Mechanism lubrication</li>
                        <li>Zero call-out fee applied</li>
                    </ul>
                </div>
                <div class="price-card">
                    <h3>uPVC Gearbox Repair</h3>
                    <p class="price-value">From £79</p>
                    <ul class="price-features">
                        <li>Replacement center mechanism</li>
                        <li>Full multipoint lock testing</li>
                        <li>12-Month parts warranty</li>
                    </ul>
                </div>
            </div>
        </div>
    </section>
    <section class="Area-sections">
        <div class="Area-container">
            <h2>Select Your Local Coverage Area</h2>
            <p>Our mobile units operate across neighboring North West London boroughs for rapid response:</p>
            <div class="area-grid">
                <a href={base + /"Barnet.html"} class="area-box">Barnet & Surrounding Postcodes</a>
                <a href={base + /"Camden.html"} class="area-box">Camden Town & Surrounds</a>
                <a href={base + /"Wembley.html"} class="area-box">Wembley & Harrow Hub</a>
            </div>
        </div>
    </section>
    <Footer />
    <script>
      import '../conf/menu.js';
      import '../conf/validation.js';
    </script>
    </body>
</html>