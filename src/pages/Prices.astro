---
import Nav from './components/Nav.astro';
import Footer from './components/Footer.astro';
import '../styles/style.css';
---
<!DOCTYPE html>
<html lang="en">
    <head>
     <title>Transparent Locksmith Prices NW London | No Call-Out Fee</title>
     <link rel="icon" type="image/svg+xml" href="/images/logo.svg?v=2">
     <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="style.css">
    </head>
    <body>
	<Nav />

    <header>
    <section class="service-hero">
        <div class="service-hero-content">
           <span class="hero-tag">Clear & Honest Pricing</span>
            <h1>Upfront Rates With Zero Hidden Charges</h1>
            <p>We provide clear telephone estimates before dispatching an engineer to your property. No surprises, no hidden call-out fees.</p> 
            <div class="hero-cta-group">
                <a href="tel:+447312158704" class="btn-call-red">📞 Call For An Immediate Quote</a>
                <a href="Contact.html" class="btn-quote-white">Send Us A Message</a>
            </div>
            <div class="hero-feature-badges">
                <div class="badge-item">💳 £0 Call-Out Fee</div>
                <div class="badge-item">🛡️ 12-Month Guarantee</div>
                <div class="badge-item">⚡ Non-Destructive Entry Focus</div>
                <div class="badge-item">🔒 Fixed Price Estimates</div>
            </div>
        </div>
    </section>
    </header>
    <section class="Prices-section">
        <div class="price-container">
            <h2>Our Standard Pricing Breakdown</h2>
            <p class="subtitle">Fair and competitive rates for all North West London locations.</p>
            <div class="price-grid">
                <div class="price-card">
                    <h3>Emergency Lockout Entry</h3>
                    <p class="price-value">From £59</p>
                    <ul class="price-features">
                        <li>✔️ Non-destructive entry focus</li>
                        <li>✔️ Under 30-min arrival target</li>
                        <li>✔️ £0 Call-out charge applied</li>
                        <li>✔️ Available 24 Hours / 7 Days</li>
                    </ul>
                </div>
                <div class="price-card">
                    <span class="pop-tag">Most Popular</span>
                    <h3>Lock Replacement & Upgrades</h3>
                    <p class="price-value">From £69</p>
                    <ul class="price-features">
                        <li>✔️ British Standard BS3621 options</li>
                        <li>✔️ Anti-snap & anti-drill cylinders</li>
                        <li>✔️ Includes 3 new keys</li>
                        <li>✔️ 12-Month parts & labor guarantee</li>
                    </ul>
                </div>
                <div class="price-card">
                    <h3>Lock & Door Repair</h3>
                    <p class="price-value">From £49</p>
                    <ul class="price-features">
                        <li>✔️ uPVC gearbox & handle fixes</li>
                        <li>✔️ Door alignment & hinge adjustments</li>
                        <li>✔️ Broken key extraction</li>
                        <li>✔️ Full hardware health check</li>
                    </ul>
                    <a href="tel:+442012345678" class="btn-call-red">Call 020 1234 5678</a>
                </div>
            </div>
        </div>
    </section>
    <Footer />
    <script is:inline src="/menu.js"></script>
    <script is:inline src="/validation.js"></script>
    </body>
</html>