---
import Nav from './components/Nav.astro';
import Footer from './components/Footer.astro';
import '../styles/style.css';
import '../conf/menu.js;
import '../conf/validation.js;
const base = import.meta.env.BASE_URL;
---

<!DOCTYPE html>
<html lang="en">
    <head>
        <title>About Our Locksmiths</title>
        <link rel="icon" type="image/svg+xml" href={`${import.meta.env.BASE_URL}/images/logo.svg?v=2`}>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <link rel="stylesheet" href="style.css">
    </head>
    <body>
    <Nav />

    <header>
            <div class="hero-container">
                <div class="hero-text">
                    <h1>About Locksmiths</h1>
                    <p>Local, independent, and trusted emergency locksmith services.</p>
                    <a href="tel:+447312158704" class="btn-call">📞 Call Now: 731 2158 704</a>
                </div>
            </div>
        </header>
        <section class="Abous-us">
            <div class="About_us-container">
                <div class="About-us-img">
                    <img src={`${base}/images/locksmith.avif`} alt="Locksmith technician fitting a high-security lock cylinder on a front door">
                </div>
                <div class="Why-us-content">
                    <h1 class="About-title">Who We Are?</h1>
                    <p>We are a local, independent locksmith business committed to providing fast response times and fair, upfront pricing with no hidden surprises.</p>
                    <p>Unlike third-party lead networks, we operate with complete accountability and transparency. Every service call is handled directly by an accredited professional, ensuring your property is secured to strict British Standards (BS3621).</p>
                    <div class="About-us-higlights">
                        <div class="Abous-us-card">
                            <h3>DBS BACKGROUND CHECKED</h3>
                            <p>Clear criminal record & verified identity for secure entry.</p>
                        </div>
                        <div class="Abous-us-card">
                            <h3>FULLY INSURED EXPERT</h3>
                            <p>Backed by comprehensive Public Liability Insurance.</p>
                        </div>
                        <div class="Abous-us-card">
                            <h3>CERTIFIED TECHNICIAN</h3>
                            <p>Fully trained and background-vetted.</p>
                        </div>
                    </div>
                </div>
            </div>
        </section>
    <Footer />
    <script is:inline src="/menu.js"></script>
    <script is:inline src="/validation.js"></script>
    </body>
</html>